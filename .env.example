# Every variable the project reads, with local sample values (Standards §3).
# Copy to .env for local work. Never put real secrets here.

# --- Local infrastructure (docker compose) ---
# Registry host for base images; switch to an Iranian mirror when Docker Hub is blocked (Tech §13.4).
REGISTRY_MIRROR=docker.io

# --- DB_: PostgreSQL ---
DB_PORT=5432
DB_SUPERUSER_PASSWORD=postgres-local-only
DB_NAME=payknameh
DB_TEST_NAME=payknameh_test
DB_MIGRATOR_USER=payknameh_migrator
DB_MIGRATOR_PASSWORD=migrator-local-only
DB_APP_USER=payknameh_app
DB_APP_PASSWORD=app-local-only

# --- S3_: object storage (MinIO locally) ---
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY_ID=payknameh-local
S3_SECRET_ACCESS_KEY=payknameh-local-secret
S3_BUCKET=payknameh-local
