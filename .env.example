# Every variable the project reads, with local sample values (Standards §3).
# Copy to .env for local work. Never put real secrets here.

# === App and worker (validated in src/env.ts) ===

# local | development | staging | production. Never branch on NODE_ENV.
APP_ENV=local

# pino level: fatal | error | warn | info | debug | trace (default info).
LOG_LEVEL=debug

# --- APP_: build identity (set by the Docker build; locally taken from git) ---
# APP_COMMIT=abc1234

# --- WORKER_: worker process ---
WORKER_HEALTH_PORT=3001

# --- DB_: PostgreSQL ---
# App connects with the least-privilege user; migrations use DB_MIGRATE_URL (Standards §7).
DB_URL=postgres://payknameh_app:app-local-only@localhost:5432/payknameh
DB_MIGRATE_URL=postgres://payknameh_migrator:migrator-local-only@localhost:5432/payknameh

# Integration tests only (pnpm test:int): same users, separate database.
DB_TEST_URL=postgres://payknameh_app:app-local-only@localhost:5432/payknameh_test
DB_TEST_MIGRATE_URL=postgres://payknameh_migrator:migrator-local-only@localhost:5432/payknameh_test

# --- S3_: object storage (MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=payknameh-local
S3_ACCESS_KEY_ID=payknameh-local
S3_SECRET_ACCESS_KEY=payknameh-local-secret

# === Local infrastructure only (docker-compose.yml) ===

# Registry host for base images; switch to an Iranian mirror when Docker Hub is blocked (Tech §13.4).
REGISTRY_MIRROR=docker.io

# Must match the users and passwords in DB_URL and DB_MIGRATE_URL above.
DB_PORT=5432
DB_SUPERUSER_PASSWORD=postgres-local-only
DB_NAME=payknameh
DB_TEST_NAME=payknameh_test
DB_MIGRATOR_USER=payknameh_migrator
DB_MIGRATOR_PASSWORD=migrator-local-only
DB_APP_USER=payknameh_app
DB_APP_PASSWORD=app-local-only

S3_PORT=9000
S3_CONSOLE_PORT=9001
