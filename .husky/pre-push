# main and develop change only through reviewed PRs (GitHub rulesets); never push to them.
protected='^refs/heads/(main|develop)$'
while read -r local_ref local_sha remote_ref remote_sha; do
  if printf '%s\n' "$remote_ref" | grep -Eq "$protected"; then
    echo "pre-push: pushing to ${remote_ref#refs/heads/} is not allowed. Open a pull request instead." >&2
    exit 1
  fi
done
exit 0
